<%# Responsibility: Sensor CREATE fields and the placement arm/cancel button. %>
<%# Native disclosure is UI-only; SensorPlacement owns all event state. %>
<details open class="rounded-lg border border-slate-200 bg-white">
  <summary class="cursor-pointer px-3 py-2 font-semibold">Add a Sensor</summary>
<section class="border-t border-slate-100 p-3">
  <label class="mt-3 block text-slate-700">Name
    <input type="text" value="New sensor" data-sensor-name
           class="mt-1 w-full rounded border border-slate-300 px-2 py-1">
  </label>
  <label class="mt-3 block text-slate-700">Colour
    <input type="color" value="#334155" data-sensor-color
           class="mt-1 h-9 w-full rounded border border-slate-300">
  </label>
  <label class="mt-3 block text-slate-700">Icon
    <select data-sensor-icon class="mt-1 w-full rounded border border-slate-300 px-2 py-1">
      <option value="circle">Circle</option>
      <option value="triangle">Triangle</option>
      <option value="square">Square</option>
    </select>
  </label>
  <button type="button" data-placement-button disabled aria-disabled="true"
          class="mt-3 w-full rounded bg-slate-900 px-3 py-2 font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">
    Place sensor (enabled in Step 42)
  </button>
</section>
</details>
