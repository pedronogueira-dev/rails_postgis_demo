<%# Responsibility: compose collapsible Sensor search behavior and results. %>
<details open class="rounded-lg border border-slate-200 bg-white">
  <summary class="cursor-pointer px-3 py-2 font-semibold">Sensor proximity</summary>
  <section class="border-t border-slate-100 p-3">
    <p class="mb-3 text-xs text-slate-700">Click empty map space to query PostGIS.</p>
    <%= render "maps/sensor_radius_field" %>
    <%= render "maps/sensor_results" %>
    <p class="mt-3 text-xs text-slate-600">
      Blank basemap? <%= link_to "Renderer diagnostics", map_diagnostics_path(style: "inline"),
        class: "font-semibold text-blue-700 underline" %>
    </p>
  </section>
</details>
