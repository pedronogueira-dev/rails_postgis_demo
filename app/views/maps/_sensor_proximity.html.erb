<%# Responsibility: Sensor radius, read/query status and nearby results. %>
<section>
  <h1 class="text-lg font-semibold">Sensor proximity</h1>
  <p class="mt-2 leading-5 text-slate-700">Click empty map space to query PostGIS.</p>
  <label for="sensor-radius" class="mt-4 block font-medium text-slate-800">
    Radius: <strong><span data-radius-value>1000</span> m</strong>
  </label>
  <input id="sensor-radius" type="range" min="100" max="5000" step="100"
         value="1000" data-radius class="mt-2 w-full">
  <p class="mt-2 text-xs text-slate-600">
    Blank basemap? <%= link_to "Run renderer diagnostics", map_diagnostics_path(style: "inline"),
      class: "font-semibold text-blue-700 underline" %>
  </p>
  <p data-basemap-status role="status" class="mt-3 text-blue-700">Starting basemap...</p>
  <p data-status role="status" class="mt-1 text-slate-600">Loading sensors...</p>
  <h2 class="mt-4 font-semibold">Nearby sensors</h2>
  <ul data-sensor-results class="mt-1 list-disc space-y-1 pl-5 text-slate-700"></ul>
</section>