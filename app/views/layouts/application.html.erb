<!DOCTYPE html>
<html>
  <head>
    <title>Tiny PostGIS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application",
          type: "module",
          "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>